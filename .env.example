# Application Environment (development/production)
ENVIRONMENT=development

# OpenAI-compatible LLM used for triage and ticket questions.
# Leave LLM_API_KEY empty to use the local heuristic fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.lmstudio.ai/v1
LLM_MODEL=llama-3.3-70b-instruct

# Database connection URL (Default is SQLite for local development)
DATABASE_URL=sqlite:///./tickets.db

# Slack Webhook URL for high-priority alerts (get from Slack App incoming webhooks)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Email Ingestion Settings for polling IMAP (Gmail example shown here)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=support@example.com
# For Gmail/Outlook, use an app password instead of your normal sign-in password
IMAP_PASSWORD=your_email_app_password_here
# Email polling interval in seconds
EMAIL_POLL_INTERVAL=15
# API key used to manually trigger demo ingestion endpoints such as /ingest/email/poll
INGEST_API_KEY=demo-secret

# SMTP Settings for sending replies (Gmail example shown here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASSWORD=your_email_app_password_here
SMTP_FROM_EMAIL=support@example.com

# ChromaDB Settings for vector search
CHROMADB_PATH=./chroma_db
CHROMADB_COLLECTION=tickets

# Backend API host and port configuration
API_HOST=0.0.0.0
API_PORT=8001

# Frontend URL used for CORS setup (e.g., http://localhost:5173 for local Vite dev)
FRONTEND_URL=http://localhost:5173

# Vite uses this target for Ticket Service API requests during local development.
VITE_TICKET_SERVICE_URL=http://localhost:8001
# Use /tickets/ only when the UI is served by the integration reverse proxy.
VITE_APP_BASE_PATH=/
VITE_API_URL=/api
# MissionControl is the only identity provider; no ticket-specific credentials are stored.
VITE_DIRECTORY_SERVICE_URL=http://localhost:8000
VITE_DIRECTORY_APP_URL=http://localhost:8000/

# Directory Service validates all technician-facing Ticket Service requests.
# Do not copy the Directory Service JWT secret into this application.
DIRECTORY_SERVICE_URL=http://localhost:8000
DIRECTORY_SERVICE_TIMEOUT_SECONDS=5
TICKET_SERVICE_API_KEY=
