# Stage 1: Build
FROM node:20-slim AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./

# Accept standalone or composed-workspace build arguments.
ARG VITE_API_URL
ARG VITE_APP_BASE_PATH=/
ARG VITE_DIRECTORY_SERVICE_URL
ARG VITE_DIRECTORY_APP_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_BASE_PATH=$VITE_APP_BASE_PATH
ENV VITE_DIRECTORY_SERVICE_URL=$VITE_DIRECTORY_SERVICE_URL
ENV VITE_DIRECTORY_APP_URL=$VITE_DIRECTORY_APP_URL

RUN npm run build

# Stage 2: Serve
FROM nginx:alpine
# Copy built static files
COPY --from=builder /app/dist /usr/share/nginx/html
# Copy custom nginx config as a template for envsubst
COPY frontend/nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
